# EmailJS Configuration (for secure email sending)
# Get these from https://www.emailjs.com/ → Account → API Keys

# Your EmailJS Public Key
EMAILJS_PUBLIC_KEY=your_public_key_here

# Your EmailJS Private Key (NEVER share this - keep it secret)
EMAILJS_PRIVATE_KEY=your_private_key_here

# EmailJS Service ID (create a service in EmailJS dashboard)
EMAILJS_SERVICE_ID=service_solar_design

# EmailJS Template ID (create a template in EmailJS dashboard)
EMAILJS_TEMPLATE_ID=template_solar_lead

# Server Port (optional, defaults to 3001)
PORT=3001
